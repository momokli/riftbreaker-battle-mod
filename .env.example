# Riftbreaker battle stack — Konfiguration (Issue #1093).
#
# Kopieren nach `.env` (git-ignoriert) und anpassen:
#   cp .env.example .env
#
# `docker compose up --build -d` liest `.env` aus dem Repo-Root automatisch.
# Secrets (Server-Passwort) stehen NUR hier — NIE im Repo. Für die lokale,
# nur an 127.0.0.1 gebundene Instanz sind die Defaults unkritisch.

# --- Modus (Issue #1093) ----------------------------------------------------
# solo   -> 1 Dedi, Lobby-Button SOLO
# versus -> 2 Dedis (A/B), Lobby-Button VERSUS
RBB_MODE=solo

# --- Build-/Deploy-Identitaet -------------------------------------------------
# Ref/SHA des Checkouts (Image-Tag + RBB_REF in Containern/Logs). Wird vom
# dünnen Wrapper aus `git rev-parse --short` gesetzt; hier nur ein Default.
RBB_REF=dev

# --- Ports (Host, alle an 127.0.0.1 gebunden) --------------------------------
# Entry-Proxy besitzt 6321 (client-hardgewired). Der Dedi publiziert auf
# RBB_SERVER_PORT; der Proxy dialt ihn.
RBB_ENTRY_PORT=6321
RBB_SERVER_PORT=6322
RBB_BRIDGE_PORT=9001
RBB_LOBBY_PORT=8088
RBB_RELAY_API_PORT=9200
RBB_ATTACK_CYCLE_PORT=9102

# --- Game-Content (HTTP-Bundle von planet, idempotent; Issue #566/#1095) -----
RBB_CONTENT_BASE=https://www.drift.projectmellon.de/downloads
RBB_CONTENT_FORCE=false

# --- Secrets (lokal unkritisch; NICHT ins Repo) ------------------------------
RBB_SERVER_PASSWORD=localdev

# --- Container-Log-Rotation (Issue #301) -------------------------------------
RBB_LOG_MAX_SIZE=10m
RBB_LOG_MAX_FILE=3
