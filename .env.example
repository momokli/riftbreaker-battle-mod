# Riftbreaker battle stack — Konfiguration (Issue #1093).
#
# Kopieren nach `.env` (git-ignoriert) und anpassen:
#   cp .env.example .env
#
# `docker compose up --build -d` liest `.env` aus dem Repo-Root automatisch.
# Secrets (Server-Passwort) stehen NUR hier — NIE im Repo. Für die lokale,
# nur an 127.0.0.1 gebundene Instanz sind die Defaults unkritisch.

# --- Modus (Issue #1093) ----------------------------------------------------
# solo   -> 1 Dedi, Lobby-Button SOLO
# versus -> 2 Dedis (A/B), Lobby-Button VERSUS
RBB_MODE=solo

# --- Build-/Deploy-Identitaet -------------------------------------------------
# Ref/SHA des Checkouts (Image-Tag + RBB_REF in Containern/Logs). Wird vom
# dünnen Wrapper aus `git rev-parse --short` gesetzt; hier nur ein Default.
RBB_REF=dev

# --- Ports (Host, alle an 127.0.0.1 gebunden) --------------------------------
# Entry-Proxy besitzt 6321 (client-hardgewired). Der Dedi publiziert auf
# RBB_SERVER_PORT; der Proxy dialt ihn.
RBB_ENTRY_PORT=6321
RBB_SERVER_PORT=6322
RBB_BRIDGE_PORT=9001
RBB_LOBBY_PORT=8088
RBB_RELAY_API_PORT=9200
RBB_ATTACK_CYCLE_PORT=9102

# --- Game-Content (HTTP-Bundle von planet, idempotent; Issue #566/#1095) -----
RBB_CONTENT_BASE=https://www.drift.projectmellon.de/downloads
RBB_CONTENT_FORCE=false

# --- Secrets (lokal unkritisch; NICHT ins Repo) ------------------------------
RBB_SERVER_PASSWORD=localdev

# --- Env-Label (Bundle-Pfad/Logs) --------------------------------------------
RBB_ENV=local

# --- Observer/Control-Service-Token (lokal unkritisch; NICHT ins Repo) --------
# Ohne Token starten server-control/tournament/capsule fail-closed nicht.
RBB_SERVER_CONTROL_TOKEN=localdev
RBB_TOURNAMENT_TOKEN=localdev
RBB_CAPSULE_TOKEN=localdev
# warm-Claim-Quelle der Kapsel (warmed capsule, #1108).
RBB_WARM_TOKEN=localdev

# --- Observer/Control-Ports (Host, an 127.0.0.1 gebunden) --------------------
RBB_SERVER_CONTROL_PORT=8092
RBB_TOURNAMENT_PORT=8081
RBB_CAPSULE_PORT=9211
RBB_WARM_PORT=9201

# --- Bridge-URLs für den Tournament-Server -----------------------------------
RBBRIDGE_A_URL=http://dedicated:9001/exec
RBBRIDGE_B_URL=

# --- Pfad-Modell (#1112): Host-Root für geteilte Dirs (ABSOLUT lassen!) -----
# game/config/rbtools/gns/sessions/backups/crashes/tournament/downloads/queue.
# Der Provisioner mountet ihn 1:1 -> ein relativer Wert bricht die Sibling-Container.
RBB_HOST_ROOT=/srv/rbbattle

# --- VS: Provisioner (:8094) + Queue (:9221) ---------------------------------
# Ohne Token starten die Dienste fail-closed (Queue/Provisioner teilen das Token).
RBB_PROVISIONER_TOKEN=localdev
RBB_PROVISIONER_PORT=8094
RBB_QUEUE_TOKEN=localdev
RBB_QUEUE_PORT=9221

# --- Container-Log-Rotation (Issue #301) -------------------------------------
RBB_LOG_MAX_SIZE=10m
RBB_LOG_MAX_FILE=3
