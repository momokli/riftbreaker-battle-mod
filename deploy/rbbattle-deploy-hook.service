# rbbattle-deploy-hook — HTTP-Deploy-Endpoint (CD) für riftbreaker-battle-mod.
#
# Ersetzt den früheren SSH-Deploy aus CI (Issue #91): Der Runner auf planet
# ruft lokal http://127.0.0.1:6323 auf; der Hook aktualisiert den Checkout
# und führt DEPLOY_CMD aus (Details: deploy/hook.py, deploy/README.md).
#
# Installation: deploy/README.md → Abschnitt „CD: HTTP-Deploy-Hook (planet)".
# hook.env (EnvironmentFile) muss root:deploy 0640 sein.

[Unit]
Description=RBBattle Deploy-Hook (HTTP, CD main→dev)
Documentation=https://github.com/momokli/riftbreaker-battle-mod/blob/main/deploy/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/rbbattle-deploy
Environment=HOME=/opt/rbbattle-deploy
EnvironmentFile=/etc/rbbattle-deploy/hook.env
ExecStart=/usr/bin/python3 /opt/rbbattle-deploy/hook.py
Restart=on-failure
RestartSec=5
UMask=0027

# Hardening. NoNewPrivileges=no ist für den Standardweg nötig: DEPLOY_CMD
# eskaliert über das enge sudoers-Snippet (NOPASSWD nur für den root-owned
# Wrapper `/usr/local/bin/rbbattle-deploy` ohne Argumente — siehe README →
# „Root-Weg (Standard)"), und Ansible nutzt das bei `become: true` für root.
# NoNewPrivileges=yes würde jede setuid-Eskalation — auch sudo — unterbinden
# und den Deploy scheitern lassen. Der Hook-Prozess selbst bleibt non-root
# (User=deploy); root gibt es nur für den einen Wrapper-Aufruf.
NoNewPrivileges=no
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Schreibzugriff nur hier (Job-Logs, Checkout, Playbook-Zielpfade);
# bei anderem CHECKOUT_DIR diesen Pfad entsprechend ergänzen.
# Rollen 3–6 (tournament/website/probe) brauchen beim ersten Lauf ggf.
# zusätzliche Pfade (/etc/systemd/system, /usr/local/bin|etc, /home/momo).
ReadWritePaths=/var/log/rbbattle-deploy /opt/rbbattle-deploy /srv/rbmods-site /opt/http/rift.projectmellon.de /srv/rbgame /opt/rbmods

[Install]
WantedBy=multi-user.target
