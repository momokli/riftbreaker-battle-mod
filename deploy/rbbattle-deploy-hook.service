# rbbattle-deploy-hook — HTTP-Deploy-Endpoint (CD) für riftbreaker-battle-mod.
#
# Ersetzt den früheren SSH-Deploy aus CI (Issue #91): Der Runner auf planet
# ruft lokal http://127.0.0.1:6321 auf; der Hook aktualisiert den Checkout
# und führt DEPLOY_CMD aus (Details: deploy/hook.py, deploy/README.md).
#
# Installation: deploy/README.md → Abschnitt „CD: HTTP-Deploy-Hook (planet)".
# hook.env (EnvironmentFile) muss root:deploy 0640 sein.

[Unit]
Description=RBBattle Deploy-Hook (HTTP, CD main→dev)
Documentation=https://github.com/momokli/riftbreaker-battle-mod/blob/main/deploy/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/rbbattle-deploy
Environment=HOME=/opt/rbbattle-deploy
EnvironmentFile=/etc/rbbattle-deploy/hook.env
ExecStart=/usr/bin/python3 /opt/rbbattle-deploy/hook.py
Restart=on-failure
RestartSec=5
UMask=0027

# Hardening. Hinweis: NoNewPrivileges=yes unterbindet jede setuid-Eskalation —
# auch sudo. Braucht DEPLOY_CMD root (Ansible `become`, siehe README →
# „Wenn der Deploy root braucht"), dort NoNewPrivileges=no setzen; für einen
# Deploy ganz ohne root bleibt NoNewPrivileges=yes aktiv.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Schreibzugriff nur hier (Job-Logs + Checkout); bei anderem CHECKOUT_DIR
# diesen Pfad entsprechend ergänzen:
ReadWritePaths=/var/log/rbbattle-deploy /opt/rbbattle-deploy

[Install]
WantedBy=multi-user.target
