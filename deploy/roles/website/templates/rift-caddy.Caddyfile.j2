# Verwaltet von deploy/ role "website" (Jinja) — NICHT manuell editieren.
#
# Eigener, schlanker Caddy fuer ZWEI Hostnames:
#   * {{ landing_domain }} — statische Landing + /mod.zip (file_server)
#   * {{ cockpit_domain }} — Operator-Cockpit (Root an die IO-Bridge,
#     /tournament/* an den tournament-server)
# Plain HTTP, lauscht ausschliesslich auf 127.0.0.1:{{ rift_caddy_port }} —
# TLS terminiert weiterhin der geteilte Host-Caddy
# ({{ website_host_caddy_container }}), der hierher proxyt. Deshalb kein ACME.
# Die Hostnamen stehen in den Site-Labels (Host-Header-Routing), NICHT als
# oeffentliche Listen-Adresse: `bind 127.0.0.1` + expliziter Port halten alles
# intern.
#
# Global: Admin-Endpunkt AUS (Issue #355). rift-caddy laeuft mit
# network_mode host; Caddy belegt sonst per Default 127.0.0.1:2019 — exakt den
# Port, den die Admin-API des geteilten Host-Caddys
# ({{ website_host_caddy_container }}) nutzt. Dann landete ein
# `docker exec {{ website_host_caddy_container }} caddy reload`
# (dialt localhost:2019) per Kernel-Load-Balancing mal bei DIESEM plain
# `caddy:2` (ohne cloudflare-DNS-Provider) → HTTP 400
# "unknown module: dns.providers.cloudflare". Ohne Admin-Port keine Kollision;
# dieser Container wird ohnehin per Container-Recreate geladen, nie per reload.
{
	admin off
}

http://{{ landing_domain }}:{{ rift_caddy_port }} {
	bind 127.0.0.1
	root * {{ rift_caddy_site_root }}
	encode gzip
	file_server
}

http://{{ cockpit_domain }}:{{ rift_caddy_port }} {
	bind 127.0.0.1
	encode gzip

	# Tournament-Server (Web-UI + API) unter /tournament/* (Präfix strippen).
	handle_path /tournament/* {
		reverse_proxy 127.0.0.1:{{ tournament_port }}
	}

	# Operator-Cockpit (pipe_bridge.exe, eingebettetes cockpit.html) am Root.
	# `handle /*` (Prefix-Wildcard), NICHT `handle /` — `/` ist ein EXAKTER
	# Pfad-Match und würde /get_state + /add_resource nicht an die Bridge leiten.
	handle /* {
		basic_auth {
			operator {{ contract_basic_auth_hash }}
		}
		reverse_proxy 127.0.0.1:{{ riftbreaker_bridge_port }}
	}
}
