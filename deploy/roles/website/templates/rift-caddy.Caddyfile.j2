# Verwaltet von deploy/ role "website" (Jinja) — NICHT manuell editieren.
#
# Eigener, schlanker Caddy NUR für {{ website_domain }}: Statics aus dem
# Docroot + /tournament/*-Proxy an den tournament-server. Plain HTTP, lauscht
# ausschliesslich auf 127.0.0.1:{{ rift_caddy_port }} — TLS terminiert weiterhin
# der geteilte Host-Caddy ({{ website_host_caddy_container }}), der hierher
# proxyt. Deshalb kein Hostname im Site-Label (der Host-Caddy reicht den
# Original-Host durch) und kein ACME.
#
# Global: Admin-Endpunkt AUS (Issue #355). rift-caddy laeuft mit
# network_mode host; Caddy belegt sonst per Default 127.0.0.1:2019 — exakt den
# Port, den die Admin-API des geteilten Host-Caddys
# ({{ website_host_caddy_container }}) nutzt. Dann landete ein
# `docker exec {{ website_host_caddy_container }} caddy reload`
# (dialt localhost:2019) per Kernel-Load-Balancing mal bei DIESEM plain
# `caddy:2` (ohne cloudflare-DNS-Provider) → HTTP 400
# "unknown module: dns.providers.cloudflare". Ohne Admin-Port keine Kollision;
# dieser Container wird ohnehin per Container-Recreate geladen, nie per reload.
{
	admin off
}

:{{ rift_caddy_port }} {
	bind 127.0.0.1
	root * {{ rift_caddy_site_root }}
	encode gzip

	# /mods: Mod-Distribution (unveraendert): Zip-Download + Browse, Upload via dufs.
	redir /mods /mods/
	handle /mods/upload* {
		reverse_proxy 127.0.0.1:{{ website_upload_port }}
	}
	handle_path /mods/* {
		root * {{ rift_caddy_site_root }}/mods
		file_server browse
	}

	# /solo (Operator-Match-Page, Issue #159) ohne Datei-Endung erreichbar.
	# Der Operator-Zugangsschutz (basic_auth) ist nur aktiv, wenn
	# solo_basic_auth_hash gesetzt ist (bcrypt-Hash NUR aus Vault/Operator-ENV).
	rewrite /solo /solo.html
	@solo path /solo /solo.html
	handle @solo {
		{% if solo_basic_auth_hash %}basic_auth {
			{{ solo_basic_auth_user | default('operator') }} {{ solo_basic_auth_hash }}
		}
		{% endif %}file_server
	}

	# Tournament-Server (Web-UI + API, z. B. der /wave-Knopf) unter
	# /tournament/* — Präfix wird gestrippt.
	handle_path /tournament/* {
		reverse_proxy 127.0.0.1:{{ tournament_port }}
	}

	# pipe_bridge (Trainer-only-Kanal, Issue #265/#363): NUR die READ-Route
	# /get_state ist öffentlich verdrahtet (Issue #383, Carbonium-Dashboard).
	# Bewusst kein /bridge/* — die Bridge hat KEINE Auth (Klasse #298), ein
	# offen proxytes /exec bzw. /add_resource wäre ein ungeschützter
	# Schreibzugang ins laufende Spiel. /exec bleibt der Operator-Weg über
	# den Tournament-Server (POST /tournament/wave etc.).
	@bridgeState path /bridge/get_state
	handle @bridgeState {
		uri strip_prefix /bridge
		reverse_proxy 127.0.0.1:{{ riftbreaker_bridge_port }}
	}

	# Statics (Landing, /solo.html, /status.json, …).
	handle {
		file_server
	}
}
