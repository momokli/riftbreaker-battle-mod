# Verwaltet von deploy/ role "website" (Jinja) — NICHT manuell editieren.
#
# Eigener, schlanker Caddy fuer ZWEI Hostnames:
#   * {{ landing_domain }} — statische Landing + /mod.zip (file_server)
#   * {{ cockpit_domain }} — Operator-Cockpit (Root an die IO-Bridge,
#     /tournament/* an den tournament-server, /server/* an den
#     server-control-Agent; Issue #424). Root UND /server/* liegen hinter
#     demselben basic_auth (operator); den Agent-Bearer injiziert Caddy
#     (Issue #454).
#
# Issue #463/#498: /server/* wird NUR gerendert, wenn das jeweilige Play den
# server-control-Agenten auch deployt (server_control_enabled, Default false).
# dev und prod deployen jetzt JE einen eigenen Agenten (dev 8092, prod 8093);
# die Route zeigt daher immer auf 127.0.0.1:<server_control_port> des eigenen
# Plays — ein Klick auf "Restart server" trifft NIE den fremden Container.
# Ein Play ohne Agent laesst die Route weiterhin weg (fail-safe).
# Plain HTTP, lauscht ausschliesslich auf 127.0.0.1:{{ rift_caddy_port }} —
# TLS terminiert weiterhin der geteilte Host-Caddy
# ({{ website_host_caddy_container }}), der hierher proxyt. Deshalb kein ACME.
# Die Hostnamen stehen in den Site-Labels (Host-Header-Routing), NICHT als
# oeffentliche Listen-Adresse: `bind 127.0.0.1` + expliziter Port halten alles
# intern.
#
# Global: Admin-Endpunkt AUS (Issue #355). rift-caddy laeuft mit
# network_mode host; Caddy belegt sonst per Default 127.0.0.1:2019 — exakt den
# Port, den die Admin-API des geteilten Host-Caddys
# ({{ website_host_caddy_container }}) nutzt. Dann landete ein
# `docker exec {{ website_host_caddy_container }} caddy reload`
# (dialt localhost:2019) per Kernel-Load-Balancing mal bei DIESEM plain
# `caddy:2` (ohne cloudflare-DNS-Provider) → HTTP 400
# "unknown module: dns.providers.cloudflare". Ohne Admin-Port keine Kollision;
# dieser Container wird ohnehin per Container-Recreate geladen, nie per reload.
{
	admin off
}

http://{{ landing_domain }}:{{ rift_caddy_port }} {
	bind 127.0.0.1
	root * {{ rift_caddy_site_root }}
	encode gzip
	file_server
}

http://{{ cockpit_domain }}:{{ rift_caddy_port }} {
	bind 127.0.0.1
	encode gzip

	# Tournament-Server (Web-UI + API) unter /tournament/* (Präfix strippen).
	handle_path /tournament/* {
		reverse_proxy 127.0.0.1:{{ tournament_port }}
	}

	# Server-Control (Plane B, Issue #424): Host-Agent fuer den
	# Dedicated-Server-Container (Status/Logs/Restart/Start/Stop, config.cfg).
	# Praefix bleibt stehen (der Agent bedient /server/*).
	# Issue #454: derselbe basic_auth-Schutz wie das Cockpit-Root — ein Browser
	# kann den Bearer des Agenten nicht senden (sonst 401 vom Agenten). Caddy
	# injiziert ihn hier; der Agent bindet ohnehin nur 127.0.0.1. Ohne Token
	# (leerer Vault-Wert) entfaellt der header_up — ein literales `Bearer `
	# wuerde der Agent ablehnen.
	# Issue #463/#498: nur rendern, wenn dieses Play den Agenten deployt
	# (server_control_enabled). dev und prod deployen je einen eigenen Agenten —
	# die Route zeigt auf 127.0.0.1:<server_control_port> des jeweiligen Plays
	# (dev 8092, prod 8093), nie auf den fremden Agenten.
{% if server_control_enabled | default(false) | bool %}	handle /server/* {
		basic_auth {
			operator {{ contract_basic_auth_hash }}
		}
		reverse_proxy 127.0.0.1:{{ server_control_port }} {
{# Ansible setzt trim_blocks: der Umbruch direkt nach einem Jinja-Tag entfaellt.
   if/endif stehen deshalb am Zeilenanfang bzw. -ende — so behalten BEIDE Faelle
   (mit/ohne Token) den Umbruch vor der schliessenden Klammer (Caddy verlangt ihn). #}
{% if server_control_token | default('') %}			header_up Authorization "Bearer {{ server_control_token }}"
{% endif %}		}
	}
{% endif %}

	# Operator-Cockpit (pipe_bridge.exe, eingebettetes cockpit.html) am Root.
	# `handle /*` (Prefix-Wildcard), NICHT `handle /` — `/` ist ein EXAKTER
	# Pfad-Match und würde /get_state + /add_resource nicht an die Bridge leiten.
	handle /* {
		basic_auth {
			operator {{ contract_basic_auth_hash }}
		}
		reverse_proxy 127.0.0.1:{{ riftbreaker_bridge_port }}
	}
}
