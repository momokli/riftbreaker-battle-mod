# Verwaltet von deploy/ role "queue" (Jinja). NICHT manuell editieren.
#
# EnvironmentFile des Queue-Dienstes (Issue #998). 0600 + root:root, weil hier
# der Bearer-Token steht — der Wert gehoert NICHT in die world-readable Unit
# (`Environment=`).
QUEUE_ENV={{ queue_env }}
QUEUE_BIND={{ queue_bind }}
QUEUE_PORT={{ queue_port }}
QUEUE_TOKEN={{ queue_token }}
QUEUE_LOG_LEVEL={{ queue_log_level }}
# Nachbarn (#998): Provisioner (kalte Welten) + Referee (Lobby).
QUEUE_PROVISIONER_URL={{ queue_provisioner_url }}
QUEUE_PROVISIONER_TOKEN={{ queue_provisioner_token }}
QUEUE_PROVISIONER_TIMEOUT={{ queue_provisioner_timeout }}
QUEUE_REFEREE_URL={{ queue_referee_url }}
QUEUE_REFEREE_TOKEN={{ queue_referee_token }}
QUEUE_TIMEOUT={{ queue_timeout }}
# Match-Modell + Zustand (Match-Record, uebersteht Restart).
QUEUE_TEAM_SIZE={{ queue_team_size }}
QUEUE_ALLOW_TEAMS={{ queue_allow_teams | bool | lower }}
QUEUE_STATE_DIR={{ queue_state_dir }}