# Verwaltet von deploy/ role "queue" (Jinja). NICHT manuell editieren.
#
# Queue-Dienst pro Env (Issue #998). Bindet ausschliesslich
# {{ queue_bind }}:{{ queue_port }}; Bearer-Token PFLICHT (Env-Datei).
[Unit]
Description=RIFT BATTLE Queue-Dienst ({{ queue_env }})
After=network-online.target{{ ' docker.service' if queue_require_docker_service | default(false) | bool else '' }}
Wants=network-online.target
{% if queue_require_docker_service | default(false) | bool %}
Requires=docker.service
{% endif %}
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=root
WorkingDirectory={{ queue_install_dir }}
# Token + Nachbar-URLs aus 0600-Datei (nicht aus Environment=).
EnvironmentFile={{ queue_env_file }}
ExecStart={{ queue_python }} {{ queue_bin }}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target