# Verwaltet von deploy/ role "riftbreaker-server" (Jinja). NICHT manuell editieren.
# Community-Rezept (Issue #241): DedicatedServer.exe cli=1 config=config.cfg.
# Content wird aus {{ riftbreaker_game_dir }} gemountet (SteamCMD im Container
# übersprungen), Mod liegt unter {{ riftbreaker_mods_dir }}.
services:
  {{ riftbreaker_server_container }}:
    image: "{{ riftbreaker_server_image }}"
    container_name: {{ riftbreaker_server_container }}
    restart: unless-stopped
    init: true
    stdin_open: true
    # Container-Labels (Issue #483, US4): per `docker inspect` sichtbar, ohne
    # Log. Dieselbe Identitaet wie Landing/Tournament/Server-Control.
    labels:
      RBB_ENV: "{{ rift_env }}"
      RBB_REF: "{{ rift_deploy_ref }}"
    environment:
      LC_ALL: C.UTF-8
      LANG: C.UTF-8
      # Deploy-Identitaet im Container-Env (Issue #483, US4): der Mod-Log
      # (client-mod/lua) liest RBB_ENV/RBB_REF daraus.
      RBB_ENV: "{{ rift_env }}"
      RBB_REF: "{{ rift_deploy_ref }}"
      # Rig-Rezept: Sync-Primitive AUS (sonst Crash im Boost-Thread vor dem bind()).
      WINEESYNC: "0"
      WINEFSYNC: "0"
      # Server-I/O-Bridge (Issue #265): pipe_bridge.exe lauscht IM Container auf
      # {{ riftbreaker_bridge_container_port }} (immer 9001); der Host publiziert
      # nur 127.0.0.1:{{ riftbreaker_bridge_port }} (konsistent mit
      # tournament_bridge_a_url). Container-/Host-Port sind getrennt (Issue #289):
      # Test-Vars verschieben nur den HOST-Port (Isolation, je Lauf eindeutig
      # seit Issue #307), der Container-Port bleibt 9001.
      RBB_BRIDGE_BIND: "0.0.0.0"
      RBB_BRIDGE_PORT: "{{ riftbreaker_bridge_container_port }}"
    ports:
{% if riftbreaker_server_port_udp | default('') %}
      - "{{ riftbreaker_server_port_udp }}:6321/udp"
      - "{{ riftbreaker_server_port_udp }}:6321/tcp"
{% else %}
      # Kein fester Game-Host-Port (Issue #307): ephemerer Publish nur auf
      # 127.0.0.1 — der Game-Server bindet 6321 weiter IM Container.
      - "127.0.0.1::6321/udp"
      - "127.0.0.1::6321/tcp"
{% endif %}
      - "127.0.0.1:{{ riftbreaker_bridge_port }}:{{ riftbreaker_bridge_container_port }}"
    volumes:
      - "{{ riftbreaker_game_dir }}:/opt/riftbreaker"
      - "{{ riftbreaker_config_dir }}/config.cfg:/data/config/config.cfg:ro"
      - "{{ riftbreaker_wine_volume }}:/data/.wine"
      - "{{ riftbreaker_saves_volume }}:/data/saves"
      # Server-I/O-Tools (Issue #265, von Rolle rbtools gestagt). Read-only:
      # entrypoint injiziert Z:\opt\rbtools\rbbridge.dll und startet pipe_bridge.exe.
      - "{{ riftbreaker_rbtools_dir }}:/opt/rbtools:ro"

  # Session-Mitschnitt (Issue #280): tailt den Lua-Log im Wine-Volume (ro) und
  # schreibt pro Session eine JSONL nach {{ riftbreaker_sessions_dir }} auf dem
  # Host. Kein Port, kein Netzzugriff; toleriert Container-Restarts (Cursor).
  {{ riftbreaker_sessions_container }}:
    image: "{{ riftbreaker_sessions_image }}"
    container_name: {{ riftbreaker_sessions_container }}
    restart: unless-stopped
    depends_on:
      - {{ riftbreaker_server_container }}
    labels:
      RBB_ENV: "{{ rift_env }}"
      RBB_REF: "{{ rift_deploy_ref }}"
    environment:
      # Deploy-Identitaet (Issue #483, US4): je JSONL-Record mitgeschrieben.
      RBB_ENV: "{{ rift_env }}"
      RBB_REF: "{{ rift_deploy_ref }}"
    volumes:
      # Quelle: derselbe Wine-Prefix wie der Server (nur lesend).
      - "{{ riftbreaker_wine_volume }}:/data/.wine:ro"
      # Ziel: Host-Bind-Mount (query-bar via tail/grep/jq).
      - "{{ riftbreaker_sessions_dir }}:/data/sessions"
      - "{{ riftbreaker_sessions_script }}:/app/session_recorder.py:ro"
    command:
      - python3
      - -u
      - /app/session_recorder.py
      - --wine-prefix
      - /data/.wine
      - --out-dir
      - /data/sessions

  # Send-Tailer (Issue #713): tailt exor_logs.txt (ro) und POSTet Send-Orders
  # (-send waveN) an die Bridge (POST /order). Kein Port, nur ins Compose-Netz.
  {{ riftbreaker_send_tailer_container }}:
    image: "{{ riftbreaker_send_tailer_image }}"
    container_name: {{ riftbreaker_send_tailer_container }}
    restart: unless-stopped
    depends_on:
      - {{ riftbreaker_server_container }}
    labels:
      RBB_ENV: "{{ rift_env }}"
      RBB_REF: "{{ rift_deploy_ref }}"
    environment:
      RBB_ENV: "{{ rift_env }}"
      RBB_REF: "{{ rift_deploy_ref }}"
    volumes:
      # Quelle: derselbe Wine-Prefix wie der Server (nur lesend).
      - "{{ riftbreaker_wine_volume }}:/data/.wine:ro"
      - "{{ riftbreaker_send_tailer_script }}:/app/send_tailer.py:ro"
    command:
      - python3
      - -u
      - /app/send_tailer.py
      - --wine-prefix
      - /data/.wine
      - --bridge-url
      - "{{ riftbreaker_send_tailer_bridge_url }}"

volumes:
  {{ riftbreaker_wine_volume }}:
  {{ riftbreaker_saves_volume }}:
