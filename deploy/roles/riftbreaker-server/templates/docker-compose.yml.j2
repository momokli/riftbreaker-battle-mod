# Verwaltet von deploy/ role "riftbreaker-server" (Jinja). NICHT manuell editieren.
# Enthält das Server-Passwort im `command` → Datei-Rechte 0600 (siehe task).
services:
  {{ riftbreaker_server_container }}:
    image: "{{ riftbreaker_server_image }}"
    container_name: {{ riftbreaker_server_container }}
    restart: unless-stopped
    init: true
{# Issue #239: DedicatedServer.exe startet mit cli=1 (Console-Mode) und
   blockiert im Console-Init auf stdin (wchan=pipe_read). Ohne pty/offenes
   stdin erreicht er den "Welt booten + UDP binden"-Schritt NIE — der Server
   ist dann nicht joinable (kein Listener auf 6321). tty + stdin_open geben
   dem Prozess eine echte Konsole, damit die Welt bootet und bind() laeuft.
   Es wird NICHTS nach stdin geschrieben: die Optionen dienen ausschliesslich
   dem Console-Init (stdin nimmt keine Eingabe an). #}
    tty: true
    stdin_open: true
    shm_size: "1gb"
    ports:
      - "{{ riftbreaker_server_port_udp }}:{{ riftbreaker_server_port_udp }}/udp"
    environment:
      WINEDEBUG: "-all"
      WINEARCH: win64
      LIBGL_ALWAYS_SOFTWARE: "1"
      GALLIUM_DRIVER: llvmpipe
    volumes:
      - "{{ riftbreaker_game_dir }}:{{ riftbreaker_game_dir }}"
    # Das Steam-Layout legt das Binary unter bin/ ab; WORKDIR muss der
    # Game-Root sein, damit `bin/DedicatedServer.exe` und mods/ stimmen.
    working_dir: "{{ riftbreaker_game_dir }}"
    entrypoint: ["run-server.sh"]
    command:
{% for arg in (riftbreaker_server_command + riftbreaker_server_extra_args) %}
      - {{ arg | to_json }}
{% endfor %}
