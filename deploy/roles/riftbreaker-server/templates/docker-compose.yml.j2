# Verwaltet von deploy/ role "riftbreaker-server" (Jinja). NICHT manuell editieren.
# Community-Rezept (Issue #241): DedicatedServer.exe cli=1 config=config.cfg.
# Content wird aus {{ riftbreaker_game_dir }} gemountet (SteamCMD im Container
# übersprungen), Mod liegt unter {{ riftbreaker_mods_dir }}.
services:
  {{ riftbreaker_server_container }}:
    image: "{{ riftbreaker_server_image }}"
    container_name: {{ riftbreaker_server_container }}
    restart: unless-stopped
    init: true
    stdin_open: true
    environment:
      LC_ALL: C.UTF-8
      LANG: C.UTF-8
      # Rig-Rezept: Sync-Primitive AUS (sonst Crash im Boost-Thread vor dem bind()).
      WINEESYNC: "0"
      WINEFSYNC: "0"
      # Trainer-I/O-Bridge (Issue #265): pipe_bridge.exe lauscht im Container
      # auf {{ riftbreaker_bridge_port }}; der Host published nur
      # 127.0.0.1:{{ riftbreaker_bridge_port }} (konsistent mit
      # tournament_bridge_a_url).
      RBB_BRIDGE_BIND: "0.0.0.0"
      RBB_BRIDGE_PORT: "{{ riftbreaker_bridge_port }}"
    ports:
      - "{{ riftbreaker_server_port_udp }}:6321/udp"
      - "{{ riftbreaker_server_port_udp }}:6321/tcp"
      - "127.0.0.1:{{ riftbreaker_bridge_port }}:9001"
    volumes:
      - "{{ riftbreaker_game_dir }}:/opt/riftbreaker"
      - "{{ riftbreaker_config_dir }}/config.cfg:/data/config/config.cfg:ro"
      - "{{ riftbreaker_wine_volume }}:/data/.wine"
      - "{{ riftbreaker_saves_volume }}:/data/saves"
      # Trainer-I/O-Tools (Issue #265, von Rolle rbtools gestagt). Read-only:
      # entrypoint injiziert Z:\opt\rbtools\rbbridge.dll und startet pipe_bridge.exe.
      - "{{ riftbreaker_rbtools_dir }}:/opt/rbtools:ro"

  # Session-Mitschnitt (Issue #280): tailt den Lua-Log im Wine-Volume (ro) und
  # schreibt pro Session eine JSONL nach {{ riftbreaker_sessions_dir }} auf dem
  # Host. Kein Port, kein Netzzugriff; toleriert Container-Restarts (Cursor).
  {{ riftbreaker_sessions_container }}:
    image: "{{ riftbreaker_sessions_image }}"
    container_name: {{ riftbreaker_sessions_container }}
    restart: unless-stopped
    depends_on:
      - {{ riftbreaker_server_container }}
    volumes:
      # Quelle: derselbe Wine-Prefix wie der Server (nur lesend).
      - "{{ riftbreaker_wine_volume }}:/data/.wine:ro"
      # Ziel: Host-Bind-Mount (query-bar via tail/grep/jq).
      - "{{ riftbreaker_sessions_dir }}:/data/sessions"
      - "{{ riftbreaker_sessions_script }}:/app/session_recorder.py:ro"
    command:
      - python3
      - -u
      - /app/session_recorder.py
      - --wine-prefix
      - /data/.wine
      - --out-dir
      - /data/sessions

volumes:
  {{ riftbreaker_wine_volume }}:
  {{ riftbreaker_saves_volume }}:
