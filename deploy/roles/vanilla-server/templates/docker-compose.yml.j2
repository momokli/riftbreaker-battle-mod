# Verwaltet von deploy/ role "vanilla-server" (Jinja). NICHT manuell editieren.
# Enthält das Server-Passwort im `command` → Datei-Rechte 0600 (siehe task).
services:
  {{ vanilla_container }}:
    image: "{{ vanilla_server_image }}"
    container_name: {{ vanilla_container }}
    restart: unless-stopped
    init: true
    shm_size: "1gb"
    ports:
      - "{{ vanilla_port_udp }}:{{ vanilla_port_udp }}/udp"
    environment:
      WINEDEBUG: "-all"
      WINEARCH: win64
      LIBGL_ALWAYS_SOFTWARE: "1"
      GALLIUM_DRIVER: llvmpipe
    volumes:
      - "{{ vanilla_game_dir }}:{{ vanilla_game_dir }}"
    entrypoint: ["wine"]
    command:
{% for arg in (vanilla_server_command + vanilla_server_extra_args) %}
      - {{ arg | to_json }}
{% endfor %}
