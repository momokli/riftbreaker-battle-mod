# Verwaltet von deploy/ role "tournament-server" (Jinja). NICHT manuell editieren.
#
# EnvironmentFile des Tournament-Servers (Issue #298). 0600 + root:root, weil
# hier der Bearer-Token steht — der Wert gehoert NICHT in die world-readable
# Unit (`Environment=`).
TOURNAMENT_HOST={{ tournament_host }}
TOURNAMENT_PORT={{ tournament_port }}
TOURNAMENT_AUTO_GO=true
RBBRIDGE_A_URL={{ tournament_bridge_a_url }}
RBBRIDGE_B_URL={{ tournament_bridge_b_url }}
TOURNAMENT_WEB_DIR={{ tournament_install_dir }}/web
# Deploy-Identitaet (Issue #483, US4): in GET /health sichtbar.
TOURNAMENT_ENV={{ rift_env | default('unknown') }}
TOURNAMENT_REF={{ rift_deploy_ref | default('unknown') }}
# Bearer-Token fuer die MUTIERENDEN Routen (Issue #298). Quelle: Vault
# (vault_tournament_token) — EINE Quelle fuer Rust + Caddy + Queue.
TOURNAMENT_TOKEN={{ tournament_token }}
RUST_LOG=info
