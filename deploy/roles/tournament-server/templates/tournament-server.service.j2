[Unit]
Description=RIFT BATTLE Tournament-Server (Referee + Web-UI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory={{ tournament_install_dir }}
# Token + Laufzeitwerte aus 0600-Datei (Issue #298) — nicht aus `Environment=`
# (das waere world-readable). Enthaelt TOURNAMENT_HOST (Default 127.0.0.1) und
# den Bearer fuer die mutierenden Routen.
EnvironmentFile={{ tournament_env_file }}
ExecStart={{ tournament_install_dir }}/tournament-server
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
