# Verwaltet von deploy/ role "capsule-flow" (Jinja). NICHT manuell editieren.
#
# EnvironmentFile des Kapsel-Flow-Dienstes (Issue #931). 0600 + root:root, weil
# hier der Bearer-Token steht — der Wert gehoert NICHT in die world-readable
# Unit (`Environment=`).
CAPSULE_ENV={{ capsule_flow_env }}
CAPSULE_BIND={{ capsule_flow_bind }}
CAPSULE_PORT={{ capsule_flow_port }}
CAPSULE_TOKEN={{ capsule_flow_token }}
CAPSULE_LOG_LEVEL={{ capsule_flow_log_level }}
# Nachbarn (#928/#931): Parked-Dienst + Attack-Cycle-Control.
CAPSULE_PARKED_URL={{ capsule_flow_parked_url }}
CAPSULE_PARKED_TOKEN={{ capsule_flow_parked_token }}
CAPSULE_CYCLE_URL={{ capsule_flow_cycle_url }}
CAPSULE_TIMEOUT={{ capsule_flow_timeout }}
