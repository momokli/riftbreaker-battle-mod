# Verwaltet von deploy/ role "parked-pool" (Jinja). NICHT manuell editieren.
#
# EnvironmentFile des Parked-Pool-Dienstes (Issue #928). 0600 + root:root, weil
# hier der Bearer-Token steht — der Wert gehoert NICHT in die world-readable
# Unit (`Environment=`).
PARKED_ENV={{ parked_pool_env }}
PARKED_BIND={{ parked_pool_bind }}
PARKED_PORT={{ parked_pool_port }}
PARKED_POOL_SIZE={{ parked_pool_pool_size }}
PARKED_MAX_PARK_SECONDS={{ parked_pool_max_park_seconds }}
PARKED_REAP_INTERVAL={{ parked_pool_reap_interval }}
PARKED_INSTANCE_PREFIX={{ parked_pool_instance_prefix }}
PARKED_TOKEN={{ parked_pool_token }}
PARKED_LOG_LEVEL={{ parked_pool_log_level }}
# Provisioner (#908) — durchgereicht (Image-Tag = Deploy-SHA der Env).
PROVISIONER_ENV={{ parked_pool_provisioner_env }}
PROVISIONER_IMAGE={{ parked_pool_provisioner_image }}
PROVISIONER_CONFIG_CFG={{ parked_pool_provisioner_config_cfg }}
PROVISIONER_RBTOOLS_DIR={{ parked_pool_provisioner_rbtools_dir }}
PROVISIONER_GAME_SOURCE={{ parked_pool_provisioner_game_source }}
PROVISIONER_BASE_DIR={{ parked_pool_provisioner_base_dir }}
