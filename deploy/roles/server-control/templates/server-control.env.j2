# Verwaltet von deploy/ role "server-control" (Jinja). NICHT manuell editieren.
#
# EnvironmentFile des Agenten. 0600 + root:root, weil hier der Bearer-Token
# steht — der Wert gehoert NICHT in die world-readable Unit (`Environment=`).
SERVER_CONTROL_TOKEN={{ server_control_token }}
SERVER_CONTROL_BIND={{ server_control_bind }}
SERVER_CONTROL_PORT={{ server_control_port }}
SERVER_CONTROL_CONTAINER={{ server_control_container }}
SERVER_CONTROL_DOCKER=/usr/bin/docker
SERVER_CONTROL_TIMEOUT={{ server_control_timeout }}
SERVER_CONTROL_LOG_LEVEL={{ server_control_log_level }}
SERVER_CONTROL_CONFIG_PATH={{ server_control_config_path }}
SERVER_CONTROL_CONFIG_TEMPLATE={{ server_control_config_template }}
SERVER_CONTROL_CONFIG_VARS={{ server_control_config_vars }}
